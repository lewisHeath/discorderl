[
    {discorderl, [
        {intents, ['GUILDS', 'GUILD_MESSAGES', 'MESSAGE_CONTENT']},
        {application_id, <<"YOUR_APP_ID">>},     %% Required for commands
        {http_timeout, 30000},                   %% Request timeout in ms
        {http_retries, 3},                       %% Retries on rate limit
        {ws_dispatch_delay, 500},                %% WebSocket dispatch delay in ms
        {rate_limit_enabled, true}               %% Toggle rate limiting
    ]},
    {lager, [
        {log_root, "log/"},
        {handlers, [
            {lager_file_backend, [{file, "discorderl.log"}, {level, debug}]},
            {lager_file_backend, [{file, "error.log"}, {level, error}]}
        ]}
    ]}
].
